{
  "name": "nuxt-rive",
  "version": "1.3.0",
  "description": "Nuxt Rive module",
  "keywords": [
    "nuxt",
    "module",
    "rive",
    "animation",
    "webgl",
    "nuxt-module"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrnasil/nuxt-rive.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev docs",
    "dev:build": "nuxi build docs",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare docs",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && changelogen --release && pnpm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@nuxt/devtools-kit": "^3.4.2",
    "@nuxt/kit": "^4.6.1",
    "@rive-app/webgl2": "^2.44.2",
    "@vueuse/core": "^15.0.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.2",
    "@nuxt/devtools-ui-kit": "^3.4.2",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.1",
    "@nuxt/test-utils": "^4.3.3",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^26.6.5",
    "@vue/test-utils": "^2.5.1",
    "changelogen": "^0.6.2",
    "eslint": "^10.12.0",
    "happy-dom": "^21.0.1",
    "nuxt": "^4.6.1",
    "release-it": "21.1.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  }
}
